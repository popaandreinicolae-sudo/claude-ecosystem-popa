# Configurare credentiale pentru MCP-uri juridice de research
# Copiaza ca .env si completeaza cu propriile tale valori

# Lege5.ro plus Lege6.ro (acelasi cont)
# Daca nu ai cont, nu poti folosi legal-verificator-ro pentru full text
LEGE5_EMAIL=your-email@example.com
LEGE5_PASSWORD=your-password
LEGE6_EMAIL=your-email@example.com
LEGE6_PASSWORD=your-password

# Zotero API
# Genereaza key la https://www.zotero.org/settings/keys
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_USER_ID=your_zotero_user_id_here

# EurLex plus HUDOC nu necesita credentiale
# Doctrine-verifier nu necesita credentiale
